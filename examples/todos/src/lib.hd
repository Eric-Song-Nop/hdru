use dep.ui.{
    Mutate,
    Palette,
    Keyed,
    keyed,
    Signal,
    Style,
    Theme,
    Ui,
    button,
    column,
    for_keyed,
    field,
    field_input,
    submit_fields,
    memo,
    on_submit,
    provide_theme,
    rgba,
    row,
    show,
    signal,
    style_live,
    text,
    view,
}

## A button that reads on either palette.
fn quiet() -> Style:
    Style::empty().padding_x(10.0).padding_y(4.0).radius(6.0).border(1.0, rgba(128, 128, 128, 128)).bg(rgba(0, 0, 0, 0)).cursor(.Pointer)

struct Todo:
    title: Signal[string]
    done: Signal[bool]

## Appends a todo titled `title` unless it is blank, and clears the draft.
fn add(todos: Keyed[usize, Todo], next_id: Signal[usize], draft: Signal[string], title: string) -> void $ Mutate:
    trimmed := title.trim()
    if trimmed == "":
        return
    id := next_id.peek()
    next_id.set(id + 1)
    todos.insert(id, Todo { title: todos.cell(trimmed), done: todos.cell(false) })
    draft.set("")

fn todo_row(todos: Keyed[usize, Todo], id: usize, todo: Todo) -> void $ Ui:
    row(style=Style::empty().gap(8.0).align(.Center)):
        # A done row fades: one key, restyled when the item changes.
        style_live:
            Style::empty().opacity(if todo.done.get(): 0.5 else: 1.0)
        view(style=Style::empty().grow(1.0)):
            text:
                if todo.done.get():
                    "[x] ${todo.title.get()}"
                else:
                    "[ ] ${todo.title.get()}"
        button(
            fn():
                todo.done.update(fn(value): !value)
            ,
            style=quiet(),
        ):
            text(fn(): "toggle")
        button(
            fn():
                todos.remove(id)
            ,
            style=quiet(),
        ):
            text(fn(): "remove")

fn list() -> void $ Ui + Theme:
    theme := $.use(Theme).palette()
    todos := keyed(
        [
            (1, Todo { title: signal("write the core"), done: signal(true) }),
            (2, Todo { title: signal("write the builders"), done: signal(false) }),
            (3, Todo { title: signal("ship a browser demo"), done: signal(false) }),
        ],
    )
    next_id := signal::[usize](4)
    draft := field(.Label("New todo"), "", fn(title: string) -> Result[void, string]:
        if title.trim() == "": .Err("Enter a title") else: .Ok(())
    )
    remaining := memo:
        let left = 0
        for todo in todos.items():
            if !todo.done.get():
                left += 1
        left
    p := theme.peek()
    column(style=Style::empty().gap(8.0).padding(16.0).radius(8.0).border(1.0, p.line)):
        style_live:
            q := theme.get()
            Style::empty().bg(q.surface).color(q.on_surface).border_color(q.line)
        text:
            "${remaining.get()} left"
        for_keyed(todos, fn(id, todo): todo_row(todos, id, todo))
        row(style=Style::empty().gap(8.0)):
            field_input(draft):
                on_submit(fn(title: string):
                    if submit_fields([draft.check()]):
                        add(todos, next_id, draft.value, title)
                )
            button(
                fn():
                    if submit_fields([draft.check()]):
                        add(todos, next_id, draft.value, draft.value.peek())
                ,
                style=quiet().bg(p.accent).color(p.on_accent).border_color(p.accent),
            ):
                text(fn(): "add")
            button(
                fn():
                    todos.reverse()
                ,
                style=quiet(),
            ):
                text(fn(): "reverse")
        show(fn(): remaining.get() == 0):
            view(style=Style::empty().color(p.muted)):
                text(fn(): "all done")

## The app, for either renderer: its entries are `main.hd` and `tui.hd`.
pub fn app() -> void $ Ui:
    provide_theme(signal(Palette::light())):
        list()
