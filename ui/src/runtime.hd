## A mount owns its command queue, event handlers, ready callbacks and jobs.
## Synchronous builders select a mount while executing. Async tasks keep the
## handle and re-enter it when they publish a result.
use std.ops.{Disposable, FnMut}
use std.task.{Receiver, Sender, channel, race}
use dep.reactive.{Graph, Reactive, ComputationId, graph, with_graph, run_effect, cleanup_on, dispose, Mutate, NoTrack, Owner, OwnerId, SourceId, Track, WriteLog, batch, flush, new_owner, reset_graph_for_test}
use pkg.keys.{HandlerId, NodeId, Parent, Scope, Ui}
use pkg.protocol.{Command, Packet, Payload, UiEvent}

## A resource load waiting for a worker: a cold suspension that drives
## the loader and lands its result.
pub struct Job:
    id: usize
    stop: Receiver[void]
    pub task: Suspend[void, 'static]

struct Listener:
    raw: fn(string) -> void $ Mutate
    typed: fn(Payload) -> void $ Mutate

pub struct Runtime:
    pub generation: usize
    pub last_event_error: string?
    pub next_field: usize
    realm: *mut Graph
    root: OwnerId?
    closed: bool
    pub writing: bool
    pub ended: bool
    pub drained: bool
    pub running: bool
    pub work: Pulse
    pub output: Pulse
    pub stop: Pulse
    out: List[Command]
    handlers: Map[HandlerId, Listener]
    next_node: usize
    next_handler: usize
    ## Jobs by id, until a worker takes one.
    stops: Map[usize, Sender[void]]
    busy: usize
    jobs: Map[usize, Job]
    ## Ids registered since the loop last took them.
    unposted: List[usize]
    next_job: usize
    ## What runs once the commands queued so far have been applied.
    ready: List[fn() -> void $ Mutate]
    ## The sources the last dispatched handler wrote.
    last_writes: List[SourceId]

## Binary notification. Observers copy the receiver before checking state.
pub struct Pulse:
    pair: (Sender[void], Receiver[void])?

impl Pulse:
    pub fn receiver(&mut self) -> Receiver[void]:
        if self.pair.is_none():
            self.pair = .Some(channel::[void](capacity=1))
        self.pair.expect("pulse initialized")._1

    pub fn notify(&mut self) -> void:
        match self.pair:
            .Some(pair) => pair._0.close()
            .None => pass
        self.pair = .None

NEXT_MOUNT := box::[usize](1)

pub fn new_runtime(realm: *mut Graph) -> *mut Runtime:
    generation := *NEXT_MOUNT
    *NEXT_MOUNT += 1
    box(Runtime {
        generation: generation, next_field: 1, last_event_error: .None,
        realm: realm, root: .None, closed: false, writing: false, drained: false, ended: false, running: false,
        work: Pulse { pair: .None },
        output: Pulse { pair: .None },
        stop: Pulse { pair: .None },
        out: [], handlers: {}, next_node: 1, next_handler: 1, jobs: {}, stops: {}, busy: 0, unposted: [], next_job: 1, ready: [], last_writes: [],
    })

struct Selection:
    current: *mut Runtime

ACTIVE := box(Selection { current: new_runtime(graph()) })

pub fn runtime() -> *mut Runtime:
    ACTIVE.current

pub fn in_runtime[T, $R](rt: *mut Runtime, body: fn() -> T $ R) -> T $ R:
    previous := ACTIVE.current
    ACTIVE.current = rt
    result := with_graph(rt.realm, body)
    ACTIVE.current = previous
    result

pub fn ui_effect[F < 'static & FnMut() -> bool $ Reactive](owner: OwnerId, mut run: F) -> ComputationId:
    rt := runtime()
    run_effect(owner, fn() -> bool $ Reactive: in_runtime(rt, fn() -> bool $ Reactive: run()))

pub fn ui_cleanup[F < 'static & FnMut() -> void](owner: OwnerId, mut callback: F) -> void:
    rt := runtime()
    cleanup_on(owner, fn() -> void: in_runtime(rt, fn() -> void: callback()))

## Queues one command for the next `take_commands`.
pub fn emit(command: Command) -> void:
    rt := runtime()
    if !rt.closed:
        if rt.out.is_empty():
            rt.output.notify()
        rt.out.push(command)

## Makes a node id and emits its `Create`.
pub fn create_node(kind: string) -> NodeId:
    rt := runtime()
    node := rt.next_node
    rt.next_node += 1
    emit(.Create(node, kind))
    node

## Queues `callback` to run after the host has applied the commands queued so
## far (`run_ready`).
pub fn after_apply[F < 'static & FnMut() -> void $ Mutate](mut callback: F) -> void:
    erased := fn() -> void $ Mutate: callback()
    runtime().ready.push(erased)

## Runs what `after_apply` queued, in order, as one batch, and flushes. The loop
## calls this after each `apply!`; a test without a loop calls it itself.
pub fn run_ready() -> void:
    rt := runtime()
    queue := rt.ready
    rt.ready = []
    log := box(WriteLog { sources: [] })
    $.with(Mutate=log):
        batch(
            fn() -> void $ Mutate:
                for callback in queue:
                    callback()
            ,
        )
    flush()

## Registers a handler and returns its id.
pub fn register_listener[F < 'static & FnMut(string) -> void $ Mutate, T < 'static & FnMut(Payload) -> void $ Mutate](
    mut raw: F, mut typed: T,
) -> HandlerId:
    rt := runtime()
    id := rt.next_handler
    rt.next_handler += 1
    rt.handlers[id] = Listener {
        raw: fn(value: string) -> void $ Mutate: raw(value),
        typed: fn(value: Payload) -> void $ Mutate: typed(value),
    }
    id

pub fn register_handler[F < 'static & FnMut(string) -> void $ Mutate](mut handler: F) -> HandlerId:
    register_listener(fn(value: string) -> void $ Mutate: handler(value),
        fn(value: Payload) -> void $ Mutate: handler(value.as_text()))

pub fn unexpected(expected: string) -> void:
    runtime().last_event_error = .Some("expected $expected")

pub fn drop_handler(id: HandlerId) -> void:
    _ := runtime().handlers.remove(id)

## Registers a job and returns its id. The loop takes it with
## `take_new_jobs` and hands it to a worker.
pub fn register_job(task: Suspend[void, 'static]) -> usize:
    rt := runtime()
    id := rt.next_job
    rt.next_job += 1
    let (stop, stopped) = channel::[void](capacity=1)
    rt.stops[id] = stop
    rt.jobs[id] = Job { id: id, stop: stopped, task: task }
    if rt.unposted.is_empty():
        rt.work.notify()
    rt.unposted.push(id)
    id

## Reuse a queued position on refresh. A running job is superseded locally.
pub fn replace_job(old: usize?, task: Suspend[void, 'static]) -> usize:
    rt := runtime()
    match old:
        .Some(id) =>
            if rt.jobs.contains_key(id):
                rt.jobs[id].task = task
                return id
            drop_job(id)
        .None => pass
    register_job(task)

pub fn drop_job(id: usize) -> void:
    rt := runtime()
    match rt.stops.remove(id):
        .Some(stop) => stop.close()
        .None => pass
    if rt.jobs.remove(id).is_some():
        match rt.unposted.index_of(id):
            .Some(index) => _ := rt.unposted.remove(index)
            .None => pass

## Drains and returns the queued commands.
pub fn take_commands() -> List[Command]:
    rt := runtime()
    commands := rt.out
    rt.out = []
    commands

## Drains and returns the ids of the jobs registered since the last call,
## for the loop to hand to its workers.
pub fn take_new_jobs() -> List[usize]:
    rt := runtime()
    ids := rt.unposted
    rt.unposted = []
    ids

pub fn pop_job(rt: *mut Runtime) -> Job?:
    while !rt.unposted.is_empty():
        id := rt.unposted.remove(0)
        match rt.jobs.remove(id):
            .Some(job) => return .Some(job)
            .None => pass
    .None

fn stopped!(stop: Receiver[void]) -> void:
    _ := stop.recv!()

struct Occupied:
    rt: *mut Runtime
    id: usize

impl Disposable for Occupied:
    fn dispose(&mut self) -> void:
        self.rt.busy -= 1
        _ := self.rt.stops.remove(self.id)

pub fn drive_job!(rt: *mut Runtime, job: Job) -> void:
    rt.busy += 1
    using slot = Occupied { rt: rt, id: job.id }
    race!(stopped(job.stop), job.task)

## Graph counts include every mount sharing that graph. Handler and job counts
## belong to the supplied mount. A cancelling loader stays busy during cleanup.
@derive(Eq, Debug)
pub struct MountStats:
    pub sources: usize
    pub owners: usize
    pub computations: usize
    pub handlers: usize
    pub queued: usize
    pub busy: usize

pub fn mount_stats(rt: *mut Runtime) -> MountStats:
    MountStats {
        sources: rt.realm.sources.len(), owners: rt.realm.owners.len(),
        computations: rt.realm.computations.len(), handlers: rt.handlers.len(),
        queued: rt.jobs.len(), busy: rt.busy,
    }

pub fn run_job!(id: usize) -> void:
    rt := runtime()
    match rt.jobs.remove(id):
        .Some(job) => drive_job!(rt, job)
        .None => pass

## Builds `root` under a fresh owner, appending to node 0, and flushes.
## Returns the owner so the tree can be disposed. A root that needs other
## providers, say `$ Ui + Clock` to capture a clock for a loader, names
## them in its row and `mount` requires them too. So a context key that
## no ancestor provides is a compile error, here a component that needs a
## `Provided[string]` called from one whose row is `$ Ui`:
##
## ```hd
## use pkg.{Provided, Ui, column, text, use_given}
## fn title() -> void $ Ui + Provided[string]:
##     text(use_given::[string]())
## fn app() -> void $ Ui:
##     column:  # error: missing-requirement
##         title()
## ```
pub fn mount[$ R](root: fn() -> void $ Ui + R) -> OwnerId $ R:
    owner := new_owner(.None)
    scope := box(Scope { owner: owner, parent: 0 })
    $.with(Owner=scope, Parent=scope, Track=box(NoTrack {})):
        root()
    flush()
    owner

## Runs the handler of `event` inside a batch, then flushes. The sources
## the handler wrote are kept for `last_writes`.
pub fn dispatch(event: UiEvent) -> void:
    found := runtime().handlers.get(event.handler)
    match found:
        .Some(handler) =>
            payload := event.payload
            log := box(WriteLog { sources: [] })
            $.with(Mutate=log):
                batch(fn() -> void $ Mutate: (handler.raw)(payload))
            runtime().last_writes = log.sources
        .None => runtime().last_writes = []
    flush()

## The sources the handler of the last `dispatch` wrote, in the order it
## first wrote each, so a tool can show "this click wrote `count`" by
## comparing with `count.id()`. Writes by effects the flush ran are not
## the handler's and are not listed.
pub fn last_writes() -> List[SourceId]:
    runtime().last_writes

## Resets ids, clears the queues and the handler table, and empties the
## reactive graph. For tests that assert exact command lists.
pub fn reset_for_test() -> void:
    rt := runtime()
    rt.out = []
    rt.handlers = {}
    rt.next_node = 1
    rt.next_handler = 1
    for (_, stop) in rt.stops:
        stop.close()
    rt.stops = {}
    rt.jobs = {}
    rt.unposted = []
    rt.next_job = 1
    rt.ready = []
    rt.last_writes = []
    reset_graph_for_test()

## A root's runtime is also the event generation. Never retarget an old handle.
pub fn mount_in[$R](realm: *mut Graph, root: fn() -> void $ Ui + R) -> *mut Runtime $ R:
    rt := new_runtime(realm)
    rt.root = .Some(in_runtime(rt, fn() -> OwnerId $ R: mount(root)))
    rt

pub fn deliver(rt: *mut Runtime, event: UiEvent) -> void:
    if !rt.closed:
        in_runtime(rt, fn() -> void: dispatch(event))

pub fn commands(rt: *mut Runtime) -> List[Command]:
    in_runtime(rt, take_commands)

pub fn finish(rt: *mut Runtime) -> void:
    if rt.closed:
        return
    rt.closed = true
    rt.stop.notify()
    rt.work.notify()
    rt.output.notify()
    in_runtime(rt, fn() -> void:
        match rt.root:
            .Some(owner) => dispose(owner)
            .None => pass
    )
    rt.root = .None
    rt.handlers = {}
    rt.ready = []
    for (_, stop) in rt.stops:
        stop.close()
    rt.stops = {}
    rt.jobs = {}
    rt.unposted = []
    rt.out = []

pub fn unmount(rt: *mut Runtime) -> void:
    if !rt.closed:
        finish(rt)
        rt.out.push(.Clear(0))

pub fn is_closed(rt: *mut Runtime) -> bool:
    rt.closed

pub fn deliver_packet(rt: *mut Runtime, event: Packet) -> void:
    if rt.closed || event.generation != rt.generation:
        return
    in_runtime(rt, fn() -> void:
        rt.last_event_error = .None
        log := box(WriteLog { sources: [] })
        match rt.handlers.get(event.handler):
            .Some(listener) =>
                $.with(Mutate=log):
                    batch(fn() -> void $ Mutate: (listener.typed)(event.payload))
            .None => pass
        rt.last_writes = log.sources
    )
