## What every renderer shares: the contract it implements, and the loop that
## runs a tree on it: mount, send each batch of commands, dispatch each event,
## and run resource loads on a pool of worker tasks. None of it depends on a
## host, so a renderer package only adapts its `@host` trait to `Renderer`.
## `Recorder` implements it in hd, so the whole loop runs in a test.
use std.task.{join, map_join, race}
use std.ops.Disposable
use dep.reactive.new_graph
use pkg.keys.Ui
use pkg.protocol.{Command, Packet, UiEvent}
use pkg.runtime.{Runtime, commands, deliver, deliver_packet, finish, in_runtime, is_closed, drive_job, mount_in, unmount, pop_job, run_ready}

## What a renderer does. `apply!` consumes one batch of commands and
## `next_event!` waits for the next user event; a handler of 0 ends the loop.
pub enum Delivery:
    Legacy(event: UiEvent)
    Typed(packet: Packet)

pub trait Renderer:
    fn apply!(&mut self, commands: List[Command]) -> void
    fn next_event!(&mut self) -> UiEvent
    fn begin!(&mut self, generation: usize) -> void: pass
    fn receive!(&mut self) -> Delivery:
        .Legacy(self.next_event!())

# At most this many loads are in flight at once.
WORKERS := 4

# One writer per surface. Effects from a shared graph wake the destination.
fn send!(rt: *mut Runtime) -> void $ Renderer:
    if rt.writing:
        return
    rt.writing = true
    let mut batch = commands(rt)
    while !batch.is_empty():
        $.use(Renderer).apply!(batch)
        in_runtime(rt, run_ready)
        batch = commands(rt)
    rt.writing = false

fn writer!(rt: *mut Runtime) -> void $ Renderer:
    while !rt.drained:
        wait := rt.output.receiver()
        send!(rt)
        if !rt.drained:
            _ := wait.recv!()
    send!(rt)

fn event_loop!(rt: *mut Runtime) -> void $ Renderer:
    while !is_closed(rt):
        match $.use(Renderer).receive!():
            .Legacy(event) =>
                if event.handler == 0: return
                deliver(rt, event)
            .Typed(packet) =>
                if packet.generation != rt.generation: continue
                if packet.handler == 0: return
                deliver_packet(rt, packet)
        send!(rt)

fn stopped!(rt: *mut Runtime) -> void:
    if !is_closed(rt):
        wait := rt.stop.receiver()
        _ := wait.recv!()

fn events!(rt: *mut Runtime) -> void $ Renderer:
    race!(event_loop(rt), stopped(rt))
    rt.ended = true
    rt.work.notify()

fn worker!(rt: *mut Runtime) -> void $ Renderer:
    while true:
        wait := rt.work.receiver()
        match pop_job(rt):
            .Some(job) =>
                drive_job!(rt, job)
                send!(rt)
            .None =>
                if rt.ended || is_closed(rt):
                    return
                _ := wait.recv!()

fn drive!(rt: *mut Runtime) -> void $ Renderer:
    let mut slots: List[usize] = []
    for slot in 0..WORKERS:
        slots.push(slot)
    _ := join!(events(rt), map_join(slots, WORKERS, fn!(_slot: usize) -> void $ Renderer: worker!(rt)))
    rt.drained = true
    rt.output.notify()

struct Mounted:
    rt: *mut Runtime

impl Disposable for Mounted:
    fn dispose(&mut self) -> void:
        finish(self.rt)
        self.rt.running = false
        self.rt.stop.notify()

pub fn run_mount!(rt: *mut Runtime) -> void $ Renderer:
    if rt.running || is_closed(rt):
        return
    rt.running = true
    using guard = Mounted { rt: rt }
    $.use(Renderer).begin!(rt.generation)
    send!(rt)
    _ := join!(drive(rt), writer(rt))

pub fn close_mount!(rt: *mut Runtime) -> void:
    unmount(rt)
    while rt.running:
        wait := rt.stop.receiver()
        _ := wait.recv!()

pub fn run_on![$R](root: fn() -> void $ Ui + R) -> void $ Renderer + R:
    rt := mount_in(new_graph(), root)
    run_mount!(rt)

## A `Renderer` for tests and scripted runs: `apply!` logs every command, and
## `next_event!` pops a scripted event, or handler 0 (stop) when the script is
## empty.
pub struct Recorder:
    pub log: List[Command]
    pub events: List[UiEvent]

impl Renderer for Recorder:
    fn apply!(&mut self, commands: List[Command]) -> void:
        for command in commands:
            self.log.push(command)

    fn next_event!(&mut self) -> UiEvent:
        if self.events.is_empty():
            UiEvent { handler: 0, payload: "" }
        else:
            self.events.remove(0)

## A recorder that will answer `clicks` in order, then stop.
pub fn scripted(clicks: List[usize]) -> *mut Recorder:
    let mut events: List[UiEvent] = []
    for handler in clicks:
        events.push(UiEvent { handler: handler, payload: "" })
    box(Recorder { log: [], events: events })
