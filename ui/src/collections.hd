use pkg.runtime.{ui_effect}
## Keyed collections: `for_each` renders one row per item and keeps a row
## alive across updates as long as its key is present.
use std.function.Fn
use std.format.{Debug, debug}
use std.hash.Hash
use dep.reactive.{Mutate, NoTrack, Owner, OwnerId, ReadSignal, Reactive, Signal, Track, dispose, new_owner, signal}
use pkg.keys.{NodeId, Parent, Scope, Ui}
use pkg.runtime.{create_node, emit}

struct Row[T < 'static]:
    owner: OwnerId
    node: NodeId
    item: Signal[T]

struct Rows[T < 'static, K < 'static & Eq & Hash]:
    rows: Map[K, Row[T]]
    order: List[K]

# Positions of retained rows that can stay in place. A monotonic update
# skips the binary searches entirely. A missing old position is a new row.
fn stationary(positions: List[usize?]) -> Map[usize, bool]:
    let mut tails: List[usize] = []
    let mut previous: Map[usize, usize] = {}
    for i in 0..positions.len():
        match positions[i]:
            .None => pass
            .Some(position) =>
                let low = tails.len()
                let high = low
                if low > 0 && positions[tails[low - 1]].expect("retained") >= position:
                    low = 0
                    while low < high:
                        mid := low + (high - low) / 2
                        if positions[tails[mid]].expect("retained") < position:
                            low = mid + 1
                        else:
                            high = mid
                if low > 0:
                    previous[i] = tails[low - 1]
                if low == tails.len(): tails.push(i) else: tails[low] = i
    let mut keep: Map[usize, bool] = {}
    let cursor = tails.last()
    while cursor.is_some():
        index := cursor.expect("retained")
        keep[index] = true
        cursor = previous.get(index)
    keep

## Renders `render` once per item of `items`, keyed by `key`. When the
## list changes: a row whose key stays receives the new item through its
## signal, written only when the item differs, so an unrelated change to
## the list reruns nothing inside that row; a new key mounts a row, a
## missing key disposes one, and order changes emit `MoveBefore` only where
## the order differs. Each row renders into its own fragment node under one
## list node. Two items with one key are a panic that names the key.
pub fn for_each[
    T < 'static & Eq,
    K < 'static & Eq & Hash & Debug,
    KF < 'static & Fn(T) -> K,
    R < 'static & Fn(ReadSignal[T]) -> void $ Ui,
](items: ReadSignal[List[T]], key: KF, render: R) -> void $ Ui:
    owner := $.use(Owner).owner()
    parent := $.use(Parent).parent()
    fragment := create_node("fragment")
    emit(.Append(parent, fragment))
    state := box(Rows::[T, K] { rows: {}, order: [] })
    run := fn() -> bool $ Reactive:
        list := items.get()
        let mut new_keys: List[K] = []
        let mut seen: Map[K, bool] = {}
        for item in list:
            k := key(item)
            if seen.contains_key(k):
                panic("ui: for_each: duplicate key ${debug(k)}")
            seen[k] = true
            new_keys.push(k)
        let mut old: Map[K, usize] = {}
        for index in 0..state.order.len():
            k := state.order[index]
            if seen.contains_key(k):
                old[k] = index
            else:
                row := state.rows[k]
                dispose(row.owner)
                emit(.Remove(row.node))
                _ := state.rows.remove(k)
        let mut positions: List[usize?] = []
        for i in 0..list.len():
            item := list[i]
            k := new_keys[i]
            positions.push(old.get(k))
            if state.rows.contains_key(k):
                state.rows[k].item.set_if_changed(item)
            else:
                child := new_owner(.Some(owner))
                node := create_node("fragment")
                emit(.Append(fragment, node))
                scope := box(Scope { owner: child, parent: node })
                item_signal := $.with(Owner=scope):
                    signal(item)
                $.with(Owner=scope, Parent=scope, Track=box(NoTrack {})):
                    render(item_signal.read())
                state.rows[k] = Row { owner: child, node: node, item: item_signal }
        keep := stationary(positions)
        let before: NodeId? = .None
        let retained_after = false
        let i = new_keys.len()
        while i > 0:
            i -= 1
            node := state.rows[new_keys[i]].node
            if positions[i].is_some():
                if !keep.contains_key(i):
                    emit(.MoveBefore(fragment, node, before))
                retained_after = true
            else if retained_after:
                emit(.MoveBefore(fragment, node, before))
            before = .Some(node)
        state.order = new_keys
        false
    _ := ui_effect(owner, run)
