+    /// An add package request for `files`, named `name`.
+    fn add_package(
+        files: &[(&str, &str)],
+        name: &str,
+        requires: &[&str],
+        hosts: &[(&str, &str)],
+        direct: bool,
+    ) -> Vec<u8> {
+        let mut out = request(files, "", 8);
+        string(&mut out, name);
+        string(&mut out, &format!("web:{name}"));
+        leb(&mut out, requires.len());
+        for r in requires {
+            string(&mut out, r);
+        }
+        leb(&mut out, hosts.len());
+        for (t, p) in hosts {
+            string(&mut out, t);
+            string(&mut out, p);
+        }
+        out.push(u8::from(direct));
+        out
+    }
